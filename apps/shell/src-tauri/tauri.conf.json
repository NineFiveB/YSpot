{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YSpot",
  "version": "0.1.0",
  "identifier": "com.yspot.shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "YSpot",
        "width": 680,
        "height": 480,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../../../scripts/sign-windows.ps1",
          "-Path",
          "%1"
        ]
      }
    },
    "resources": [
      "resources/settings-catalog.json",
      "resources/THIRD-PARTY-NOTICES.md"
    ]
  }
}
