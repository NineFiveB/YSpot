{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Launcher window capabilities for M0: core IPC (invoke/listen) plus global-shortcut management.",
  "windows": ["launcher"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister"
  ]
}
